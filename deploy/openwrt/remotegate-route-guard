#!/bin/sh
set -eu

# Only RemoteGate sockets carry this mark. Do not reuse WireGuard's 0xca6c.
MARK_HEX=0x52470001
TABLE=138039
COMMENT=remotegate-direct

nft_persistent() {
 # Keep the socket identity and NAT exemption outside fw4/OpenClash's table.
 # Explicit identity DNAT establishes a binding before later REDIRECT hooks.
 # Merely ACCEPTing (even in a NAT chain) does NOT skip later NAT base chains.
 command -v nft >/dev/null 2>&1 || return 0
 replace=
 if nft list table inet remotegate_direct >/dev/null 2>&1; then
  nft list chain inet remotegate_direct rg_owned_52470001 >/dev/null 2>&1 || {
   echo 'RemoteGate direct table is owned by another configuration' >&2; return 1;
  }
  if [ "$1" = stop ]; then nft delete table inet remotegate_direct; return 0; fi
  rules="$(nft list table inet remotegate_direct)"
  intact=1
  for marker in save route nat4 nat6; do
   printf '%s\n' "$rules" | grep -q "comment \"remotegate-persist-$marker\"" || intact=0
  done
  [ "$intact" = 0 ] || return 0
  replace='delete table inet remotegate_direct'
 fi
 [ "$1" != stop ] || return 0
 nft list table inet fw4 >/dev/null 2>&1 || return 0
 {
 [ -z "$replace" ] || printf '%s\n' "$replace"
 cat <<'EOF'
table inet remotegate_direct {
 chain rg_owned_52470001 { }
 chain remember_socket {
  type filter hook output priority -199; policy accept;
  meta mark 0x52470001 ct mark set 0x52470001 comment "remotegate-persist-save"
 }
 chain restore_route {
  type route hook output priority -101; policy accept;
  ct mark 0x52470001 meta mark set 0x52470001 comment "remotegate-persist-route"
 }
 chain direct_nat {
  type nat hook output priority -110; policy accept;
  meta nfproto ipv4 ct mark 0x52470001 counter dnat ip to ip daddr comment "remotegate-persist-nat4"
  meta nfproto ipv6 ct mark 0x52470001 counter dnat ip6 to ip6 daddr comment "remotegate-persist-nat6"
 }
}
EOF
 } | nft -f -
}

nft_rules() {
 command -v nft >/dev/null 2>&1 || return 0
 nft list table inet fw4 >/dev/null 2>&1 || return 0
 batch="$(mktemp /tmp/remotegate-nft.XXXXXX)"
 trap 'rm -f "$batch"' EXIT HUP INT TERM
 for chain in nat_output dstnat_output mangle_output openclash_output openclash_mangle_output openclash_output_v6 openclash_mangle_output_v6; do
  rules="$(nft -a list chain inet fw4 "$chain" 2>/dev/null)" || continue
  # One transaction: insert the new first rule and remove only our old rules.
  if [ "$1" != stop ]; then
   printf 'insert rule inet fw4 %s meta mark %s counter return comment "%s"\n' "$chain" "$MARK_HEX" "$COMMENT" >> "$batch"
  fi
  printf '%s\n' "$rules" | awk '/comment "remotegate-direct"|comment "remotegate-bypass"/ {for(i=1;i<NF;i++)if($i=="handle" && $(i+1)~/^[0-9]+$/)print $(i+1)}' | while read -r handle; do
   printf 'delete rule inet fw4 %s handle %s\n' "$chain" "$handle" >> "$batch"
  done
 done
 [ ! -s "$batch" ] || nft -f "$batch"
 rm -f "$batch"
 trap - EXIT HUP INT TERM
}

iptables_rules() {
 for command in iptables ip6tables; do
  command -v "$command" >/dev/null 2>&1 || continue
  for table in nat mangle; do
   # FW3 also uses openclash_output in mangle. Root OUTPUT protects
   # RemoteGate from later proxy rules without changing unrelated packets.
   for chain in OUTPUT openclash_output openclash_mangle_output; do
    "$command" -t "$table" -S "$chain" >/dev/null 2>&1 || continue
    if [ "$1" = stop ]; then
     while "$command" -t "$table" -C "$chain" -m mark --mark "$MARK_HEX" -m comment --comment "$COMMENT" -j RETURN 2>/dev/null; do
      "$command" -t "$table" -D "$chain" -m mark --mark "$MARK_HEX" -m comment --comment "$COMMENT" -j RETURN
     done
    else
     first="$("$command" -t "$table" -S "$chain" | awk '$1=="-A"{print;exit}')"
     case "$first" in
      *"$COMMENT"*) ;;
      *) "$command" -t "$table" -I "$chain" 1 -m mark --mark "$MARK_HEX" -m comment --comment "$COMMENT" -j RETURN ;;
     esac
     "$command" -t "$table" -L "$chain" --line-numbers -n | awk -v c="$COMMENT" 'index($0,c)&&$1~/^[0-9]+$/&&$1>1{n[++k]=$1}END{for(i=k;i>0;i--)print n[i]}' | while read -r number; do
      "$command" -t "$table" -D "$chain" "$number"
     done
    fi
   done
  done
 done
}

case "${1:-refresh}" in
 start|refresh) nft_persistent refresh; nft_rules refresh; iptables_rules refresh ;;
 stop)
  nft_persistent stop; nft_rules stop; iptables_rules stop
  for family in -4 -6; do
   if ip "$family" rule del priority 1 fwmark "$MARK_HEX/0xffffffff" lookup "$TABLE" 2>/dev/null; then
    ip "$family" route flush table "$TABLE" proto 242
   fi
  done
  ;;
 *) echo 'usage: remotegate-route-guard start|refresh|stop' >&2; exit 2 ;;
esac
