#!/bin/sh /etc/rc.common

USE_PROCD=1
START=98
STOP=10

start_service() {
	[ -x /usr/sbin/remotegate-agent ] || return 1
	[ -f /etc/remotegate/agent.json ] || return 1
	/usr/libexec/remotegate-route-guard start
	procd_open_instance
	procd_set_param command /usr/sbin/remotegate-agent /etc/remotegate/agent.json
	procd_set_param respawn 5 30 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_set_param limits nofile="4096 4096"
	procd_close_instance
}

stop_service() {
	/usr/libexec/remotegate-route-guard stop
}

service_triggers() {
	procd_add_reload_trigger firewall openclash network
}

reload_service() {
	/usr/libexec/remotegate-route-guard refresh
}
