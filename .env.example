# 首次打开后台，在网页中创建管理员账号和密码。
# 通过域名部署时填写控制台域名；本机安装时可留空。
CONSOLE_HOST=

# 本机宝塔默认反代可直接使用上方 CONSOLE_HOST，兼容同域名 HTTP/HTTPS。
# 外部使用自定义端口时在这里填完整地址，不带后台路径；端口必须一致。
# 仅信任本机回环连接。兼容逻辑不会配置站点证书或开启 HTTPS。
# 示例：PUBLIC_URL=https://gate.example.com
PUBLIC_URL=

# Linux 服务器部署，不需要安装数据库。
REMOTE_GATE_IMAGE=ghcr.io/yehao9589/remotegate:stable
REMOTE_GATE_DATA_DIR=./data

# HTTP 仅监听服务器本机，供本机反代访问；未配置反代时可经 SSH 隧道初始化。
LISTEN_ADDR=127.0.0.1:18088
HEALTHCHECK_URL=http://127.0.0.1:18088/healthz

# 系统独立提供 HTTPS，后台和映射均直接使用系统证书。443 必须可用。
# 自愿使用外部反代时可以留空关闭；更换端口不是默认解决方案。
HTTPS_LISTEN_ADDR=:443

# 可选：独立部署的首次后台证书。留空则通过本机 / SSH 隧道初始化。
# 只在未创建管理员时使用，默认只申请后台域名；之后在网页添加泛域名。
# DNS 授权会保存到私有数据目录用于续期，不会在普通接口返回。
BOOTSTRAP_DOMAIN=
BOOTSTRAP_EMAIL=
BOOTSTRAP_DNS_PROVIDER=
BOOTSTRAP_DNS_ACCESS_KEY=
BOOTSTRAP_DNS_SECRET_KEY=
# 阅读 https://letsencrypt.org/repository/ 中的服务条款后才设为 true。
BOOTSTRAP_ACME_TERMS_ACCEPTED=false
