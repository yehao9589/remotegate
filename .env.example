# 首次打开后台，在网页中创建管理员账号和密码。
# 通过域名部署时填写控制台域名；本机安装时可留空。
CONSOLE_HOST=

# Linux 服务器部署，不需要安装数据库。
REMOTE_GATE_IMAGE=ghcr.io/yehao9589/remotegate:latest
REMOTE_GATE_DATA_DIR=./data

# HTTP 仅用于服务器本机及 SSH 隧道内的首次安装、证书配置。
LISTEN_ADDR=127.0.0.1:18088
HEALTHCHECK_URL=http://127.0.0.1:18088/healthz

# 内置 HTTPS 入口。443 已被占用时改成 :8443 等空闲端口。
HTTPS_LISTEN_ADDR=:443
